name: Build & Deploy Mat(a)Mu

on:
  push:
    branches:
      - main
  workflow_dispatch:

jobs:
  deploy:
    name: Deploy to EC2
    runs-on: ubuntu-latest
    if: github.ref == 'refs/heads/main'
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Setup SSH Agent
        uses: webfactory/ssh-agent@v0.9.0
        with:
          ssh-private-key: ${{ secrets.EC2_SSH_DEPLOY_KEY }}

      - name: Add EC2 host to known_hosts
        run: |
          mkdir -p ~/.ssh
          ssh-keyscan -H ${{ secrets.EC2_HOST }} >> ~/.ssh/known_hosts 2>/dev/null

      - name: Deploy via SSH
        run: |
          set -e
          
          EC2_USER="${{ secrets.EC2_USER }}"
          EC2_HOST="${{ secrets.EC2_HOST }}"
          DEPLOY_PATH="${{ secrets.DEPLOY_PATH }}"
          
          echo "=== Mat(a)Mu Deployment Started ==="
          
          ssh -v $EC2_USER@$EC2_HOST << 'DEPLOY_SCRIPT'
            set -e
            
            DEPLOY_PATH="/var/www/matamu"
            VENV_PATH="/home/ec2-user/matamu-env"
            
            cd "$DEPLOY_PATH"
            
            echo "=== Pulling latest changes ==="
            git fetch origin main
            git reset --hard origin/main
            git clean -fd
            
            echo "=== Installing dependencies ==="
            source "$VENV_PATH/bin/activate"
            pip install -r matamu-backend/requirements.txt
            
            echo "=== Running Migrations ==="
            cd matamu-backend
            python manage.py migrate
            python manage.py collectstatic --noinput
            
            echo "=== Restarting Backend ==="
            sudo systemctl restart matamu-backend
            
            echo "=== Deployment Completed Successfully ==="
          DEPLOY_SCRIPT
