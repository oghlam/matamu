# ============================================================
# Mat(a)Mu — .env.example
# Copy to .env and fill with real values. NEVER commit .env.
# ============================================================

# --- DJANGO ---
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-ec2-ip.compute.amazonaws.com

# --- DATABASE ---
DB_NAME=matamu
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_HOST=127.0.0.1
DB_PORT=5432

# --- AWS S3 ---
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET=matamu-evidence
AWS_DEFAULT_REGION=ap-southeast-1

# --- AWS BEDROCK (via LiteLLM proxy) ---
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=your-litellm-key
# Amazon Nova models used through LiteLLM or Bedrock Converse
SUMMARY_MODEL=amazon.nova-lite-v1:0
SEVERITY_MODEL=amazon.nova-pro-v1:0
# Backward-compatible aliases; keep them on Nova if older deployments read them.
HAIKU_MODEL=amazon.nova-lite-v1:0
SONNET_MODEL=amazon.nova-pro-v1:0
GEMINI_MODEL=amazon.nova-pro-v1:0
BEDROCK_SUMMARY_ID=amazon.nova-lite-v1:0
BEDROCK_SEVERITY_ID=amazon.nova-pro-v1:0
BEDROCK_SUMMARY_REGION=us-east-1
BEDROCK_SEVERITY_REGION=us-east-1

# --- GOOGLE MAPS API ---
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# --- EC2 / DEPLOYMENT ---
EC2_HOST=your-ec2-public-ip
EC2_USER=ubuntu
EC2_SSH_KEY=path/to/your-key.pem

# --- OPENCV / YOLO ---
YOLO_MODEL_PATH=models/yolo_road_v1.onnx
OPENCV_DNN_BACKEND=DNN_BACKEND_CUDA
OPENCV_DNN_TARGET=DNN_TARGET_CUDA
# For CPU-only (t2.small): DNN_BACKEND_DEFAULT + DNN_TARGET_CPU

# --- SFACE (Privacy Blur) ---
FACE_DETECT_MODEL=models/face_detection_yunet_2023mar.onnx
FACE_RECOG_MODEL=models/face_recognition_sface_2021dec.onnx
BLUR_FACES=True

# --- IQE (Inspection Quality Engine) ---
IQE_TRUST_THRESHOLD=0.65
IQE_BLUR_SCORE_MIN=100
IQE_BRIGHTNESS_MIN=50
IQE_BRIGHTNESS_MAX=200
IQE_GPS_ACCURACY_MAX=25

# --- AGENTIC VISION ---
AGENTIC_LOW_CONFIDENCE_THRESHOLD=0.50
AGENTIC_RECURRING_RADIUS_M=50
AGENTIC_RECURRING_DAYS=7
AGENTIC_RECURRING_MIN_REPORTS=3

# --- TYPESAFE AI (Jev) — Structured Decision Engine ---
TYPESAFE_API_KEY=your-typesafe-api-key
